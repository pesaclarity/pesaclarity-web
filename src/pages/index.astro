---
import { withBase } from "../lib/paths";
import Base from "../layouts/Base.astro";
import { links, principles, repos, repoUrl } from "../data/site";
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="pill">Free · No ads · Open source</p>
        <h1 id="hero-title">
          Your money, made clear,{" "}
          <span class="accent">without giving your data away.</span>
        </h1>
        <p class="lead">
          Pesa Clarity reads your M-Pesa and bank messages on your phone and
          turns them into a daily plan: what you can spend today, what is due,
          where money leaks, and when you will be debt-free.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={links.waitlist}>
            Join the beta waitlist
          </a>
          <a class="button button-secondary" href={links.github}>
            See the code on GitHub
          </a>
        </div>
        <ul class="trust" role="list">
          <li>No bank logins</li>
          <li>Nothing leaves your phone</li>
          <li>Every line of code public</li>
        </ul>
      </div>

      <figure class="showcase" aria-labelledby="phone-caption">
        <div class="phone">
          <div class="phone-bar" aria-hidden="true">
            <span>9:41</span>
            <span class="notch"></span>
            <span>●●●</span>
          </div>
          <p class="phone-greet">Habari, Wanjiru</p>
          <div class="today">
            <p class="today-label">Safe to spend today</p>
            <p class="today-amount number">
              <span class="currency">KES</span> 1,200
            </p>
            <p class="today-note">Weekday limit · 3,450 left this week</p>
            <div class="meter" aria-hidden="true">
              <span></span>
            </div>
          </div>
          <ul class="mini-list" role="list">
            <li>
              <span>Rent, due Friday</span>
              <span class="number">18,000</span>
              <span class="tag tag-ok">Covered</span>
            </li>
            <li>
              <span>Leaks this month</span>
              <span class="number">6,400</span>
              <span class="tag">9% of income</span>
            </li>
            <li>
              <span>Debt-free by</span>
              <span class="number">Aug 2028</span>
              <span class="tag">On track</span>
            </li>
          </ul>
        </div>

        <div class="float float-sms" aria-hidden="true">
          <p class="float-from">MPESA</p>
          <p>
            TK41X0ABCD Confirmed. Ksh450.00 paid to JAVA HOUSE. New M-PESA
            balance is Ksh8,210.00.
          </p>
        </div>
        <div class="float float-parsed" aria-hidden="true">
          <span class="dot"></span>
          <div>
            <p class="float-title">Java House · Eating out</p>
            <p class="float-sub">Read on your phone · 0 bytes uploaded</p>
          </div>
          <span class="number">−450</span>
        </div>

        <figcaption id="phone-caption" class="visually-hidden">
          The home screen answers "how am I doing today?". Figures are
          illustrative.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="stats" aria-label="Pesa Clarity in numbers">
    <div class="container">
      <dl class="stats-grid">
        <div>
          <dt>Price, for every feature</dt>
          <dd class="number">KES 0</dd>
        </div>
        <div>
          <dt>Ads, trackers or analytics</dt>
          <dd class="number">None</dd>
        </div>
        <div>
          <dt>Screens, replacing a 17-tab workbook</dt>
          <dd class="number">7</dd>
        </div>
        <div>
          <dt>Of the code you can read</dt>
          <dd class="number">100%</dd>
        </div>
      </dl>
      <p class="status muted">
        Status: pre-alpha. We are talking to users and building the parsers.
        Nothing to install yet. Figures on this page are illustrative.
      </p>
    </div>
  </section>

  <section id="what" class="section" aria-labelledby="what-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What it is</p>
          <h2 id="what-title">One number first. Detail one tap deeper.</h2>
        </div>
        <p>
          You can see every M-Pesa transaction, but not your finances. Pesa
          Clarity does the sorting for you, on the phone, and answers four
          questions in plain words.
        </p>
      </div>

      <ol class="steps" role="list" aria-label="How it gets your numbers">
        <li>
          <span class="step-n number">1</span>
          <h3>Pick your senders</h3>
          <p>
            Tick the banks and wallets you use, such as M-Pesa, KCB or Equity.
          </p>
        </li>
        <li>
          <span class="step-n number">2</span>
          <h3>Read on your phone</h3>
          <p>
            Only those senders' messages are read, on the device. No bank
            logins, no passwords.
          </p>
        </li>
        <li>
          <span class="step-n number">3</span>
          <h3>Get a daily plan</h3>
          <p>
            Statement PDFs fill in older history and check that the totals
            match.
          </p>
        </li>
      </ol>

      <ul class="bento" role="list">
        <li class="card q q-spend">
          <div class="q-visual" aria-hidden="true">
            <p class="big number">1,200</p>
            <div class="week">
              {["M", "T", "W", "T", "F", "S", "S"].map((d, i) => (
                <span class={i < 2 ? "done" : i === 2 ? "now" : ""}>{d}</span>
              ))}
            </div>
          </div>
          <h3>What can I spend today?</h3>
          <p>
            "You can spend 1,200 today." A daily limit from what is left of your
            budget, with a different one for weekends.
          </p>
        </li>
        <li class="card q">
          <ul class="q-visual upcoming" aria-hidden="true" role="list">
            <li>
              <span>School fees</span>
              <span class="warn">in 3 days</span>
            </li>
            <li>
              <span>Rent</span>
              <span>Friday</span>
            </li>
            <li>
              <span>Fuliza repay</span>
              <span>28 Oct</span>
            </li>
          </ul>
          <h3>What is coming up?</h3>
          <p>
            Rent, school fees, card charges and loan payments, with a warning
            days before a payment would fail.
          </p>
        </li>
        <li class="card q">
          <div class="q-visual bars" aria-hidden="true">
            <span style="--w: 82%">Transfers</span>
            <span style="--w: 58%">Lifestyle</span>
            <span style="--w: 36%">Fuliza</span>
            <span style="--w: 18%">Fees</span>
          </div>
          <h3>Where does my money leak?</h3>
          <p>
            Fees, Fuliza, lifestyle and transfers to friends and family, as a
            share of income, so small amounts stop hiding.
          </p>
        </li>
        <li class="card q">
          <div class="q-visual debt" aria-hidden="true">
            <div class="debt-row">
              <span>Paid off</span>
              <span class="number">62%</span>
            </div>
            <div class="meter meter-soft">
              <span style="--w: 62%"></span>
            </div>
            <p class="debt-date number">Aug 2028</p>
          </div>
          <h3>When will I be debt-free?</h3>
          <p>
            Bank loans, Fuliza and family loans in one plan, with a realistic
            date and a split for each payday.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section id="privacy" class="section dark" aria-labelledby="privacy-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Privacy promise</p>
          <h2 id="privacy-title">Your transactions never leave your phone</h2>
        </div>
        <p>
          Here is exactly what stays with you and what our server holds. Nothing
          else.
        </p>
      </div>
      <div class="privacy-split">
        <div class="panel panel-phone">
          <h3>Stays on your phone</h3>
          <ul class="check-list" role="list">
            <li>Your messages, transactions, payees and balances</li>
            <li>Statement PDFs and their passwords, used once and discarded</li>
            <li>Budgets, debts, goals and every insight</li>
            <li>The categoriser that learns from your corrections</li>
          </ul>
          <p class="small">
            Stored in an encrypted database, unlocked by your PIN or
            fingerprint.
          </p>
        </div>
        <div class="wall" aria-hidden="true">
          <span>Only this crosses</span>
        </div>
        <div class="panel">
          <h3>What our server holds</h3>
          <dl class="server-list">
            <div>
              <dt>Sign-in</dt>
              <dd>
                Your account id, phone number or email, and when you signed in
                or out. No financial data. You can also use the app without an
                account.
              </dd>
            </div>
            <div>
              <dt>Backup vault</dt>
              <dd>
                Backups encrypted on your phone with your passphrase. We cannot
                read them, so you get a printable recovery key.
              </dd>
            </div>
            <div>
              <dt>Model updates</dt>
              <dd>
                Noised, combined updates that help the categoriser improve for
                everyone. Never your data. You can switch this off.
              </dd>
            </div>
          </dl>
        </div>
      </div>
      <p class="privacy-foot">
        No ads, no analytics, no third-party trackers, in the app or on this
        site. <a href={withBase("/privacy/")}>Read the privacy summary</a>.
      </p>
    </div>
  </section>

  <section id="beliefs" class="section" aria-labelledby="beliefs-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we believe</p>
          <h2 id="beliefs-title">Five commitments behind every decision</h2>
        </div>
        <p>
          These come straight from the product spec, and they do not change.
        </p>
      </div>
      <ol class="principles" role="list">
        {principles.map((p, i) => (
          <li class="card principle">
            <span class="principle-number number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="open-source" class="section" aria-labelledby="foss-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Open source for good</p>
          <h2 id="foss-title">Don't trust us. Check the code.</h2>
        </div>
        <p>
          An app that reads your money messages should prove what it does with
          them. Every part of Pesa Clarity is open source, so anyone can confirm
          that your data stays on your phone.
        </p>
      </div>

      <ul class="repos" role="list">
        {repos.map((r) => (
          <li class="card repo">
            <a class="repo-name" href={repoUrl(r.name)}>
              {r.name}
            </a>
            <p>{r.what}</p>
            <p class="licence">{r.licence}</p>
          </li>
        ))}
      </ul>

      <div class="foss-split">
        <div class="why">
          <div>
            <h3>Why AGPL for the app and server</h3>
            <p>
              Anyone who changes them, including to run a hosted copy, must
              share their changes. A commercial licence is available on request,
              which can help fund the project.
            </p>
          </div>
          <div>
            <h3>Why Apache for the parsers</h3>
            <p>
              So banks, SACCOs, fintechs and other apps can use them freely.
              More users means more people keeping them current.
            </p>
          </div>
          <div>
            <h3>Why the name is protected</h3>
            <p>
              The code can be forked, but the Pesa Clarity name and logo cannot.
              That stops scam clones posing as the real app to harvest SMS.
            </p>
          </div>
        </div>

        <div class="card contribute">
          <h3>Add your bank or wallet</h3>
          <p>
            Each institution's messages are read by a parser pack: a small set
            of rules with tests. If yours is missing, you can add it.
          </p>
          <ol>
            <li>
              Open an issue on <a href={links.parserIssues}>ujumbe-parsers</a>{" "}
              naming the institution and its SMS sender ID.
            </li>
            <li>
              Write the pack's rules in YAML, one per message type: sent,
              received, paybill, till, reversal.
            </li>
            <li>
              Add made-up test messages with fake names and numbers like 0700
              000 000. Never paste real messages.
            </li>
            <li>Open a pull request. It is merged when every test passes.</li>
          </ol>
          <a class="button button-secondary" href={links.parserContributing}>
            Read the parser guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="join" class="join" aria-labelledby="join-title">
    <div class="container join-inner">
      <div>
        <h2 id="join-title">Help build it</h2>
        <p>
          The private beta opens to 30 to 50 people in Kenya once the Android
          app passes Play review. Join the waitlist and we will tell you when it
          is ready. New to open source? Start with the{" "}
          <a href={links.contributing}>contributing guide</a>.
        </p>
      </div>
      <div class="button-row">
        <a class="button button-light" href={links.waitlist}>
          Join the beta waitlist
        </a>
        <a class="button button-outline-light" href={links.github}>
          Star on GitHub
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-7);
    background:
      radial-gradient(
        60rem 30rem at 85% 10%,
        var(--color-brand-soft),
        transparent 70%
      ),
      var(--color-background);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-6);
    }
  }

  .pill {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-brand-link);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-4);
    margin-bottom: var(--space-5);
  }

  h1 {
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin-bottom: var(--space-5);
  }

  .accent {
    color: var(--color-brand-link);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 36rem;
    margin-bottom: var(--space-6);
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .trust li::before {
    content: "✓";
    color: var(--color-success-text);
    margin-right: var(--space-2);
  }

  .showcase {
    position: relative;
    margin: 0;
    justify-self: center;
    width: min(100%, 25rem);
    padding-block: var(--space-5) var(--space-7);
  }

  .phone {
    position: relative;
    width: min(100%, 19.5rem);
    margin-inline: auto;
    background: var(--color-surface);
    border: 10px solid #1c1215;
    border-radius: 44px;
    padding: var(--space-3) var(--space-4) var(--space-4);
    box-shadow:
      0 40px 80px -30px rgb(28 18 21 / 0.45),
      0 0 0 1px rgb(28 18 21 / 0.1);
  }

  .phone p {
    margin: 0;
  }

  .phone-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 var(--space-2) var(--space-3);
  }

  .notch {
    width: 5rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: #1c1215;
  }

  .phone-greet {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: var(--space-3) !important;
  }

  .today {
    background: var(--color-brand);
    color: var(--color-on-brand);
    border-radius: 20px;
    padding: var(--space-4) var(--space-4) var(--space-5);
  }

  .today-label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .today-amount {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-block: var(--space-1) !important;
  }

  .currency {
    font-size: 0.38em;
    font-weight: 500;
    letter-spacing: 0;
    vertical-align: 0.95em;
  }

  .today-note {
    font-size: 0.8125rem;
  }

  .meter {
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.3);
    margin-top: var(--space-3);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    width: var(--w, 35%);
    background: currentColor;
    border-radius: inherit;
  }

  .mini-list {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
  }

  .mini-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-3);
    padding: var(--space-3) var(--space-1);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .mini-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .mini-list .number {
    font-weight: 700;
    text-align: right;
  }

  .tag {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .tag-ok {
    color: var(--color-success-text);
    font-weight: 600;
  }

  .float {
    position: absolute;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 18px 40px -18px rgb(28 18 21 / 0.35);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .float p {
    margin: 0;
  }

  .float-sms {
    top: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(92%, 18.5rem);
    padding: var(--space-3);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    backdrop-filter: blur(6px);
  }

  .float-from {
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1) !important;
  }

  .float-parsed {
    bottom: -0.5rem;
    right: -10%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    width: 17rem;
  }

  .float-parsed .number {
    font-weight: 700;
    margin-left: auto;
  }

  .float-title {
    font-weight: 600;
  }

  .float-sub {
    color: var(--color-success-text);
    font-size: 0.75rem;
  }

  .dot {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 4px rgb(5 150 105 / 0.15);
  }

  @media (max-width: 40rem) {
    .float-parsed {
      right: 0;
      width: 15.5rem;
    }
  }

  /* Stats strip */
  .stats {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-6) var(--space-5);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-4);
    margin: 0;
  }

  @media (min-width: 52rem) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .stats-grid > div + div {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-5);
    }
  }

  .stats-grid div {
    display: flex;
    flex-direction: column;
  }

  .stats-grid dd {
    order: -1;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-brand-link);
  }

  .stats dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .status {
    font-size: var(--text-sm);
    margin: var(--space-5) 0 0;
  }

  /* Section heads: title left, summary right */
  .section-head {
    display: grid;
    gap: var(--space-3) var(--space-7);
    margin-bottom: var(--space-6);
    align-items: end;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head > p {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  @media (min-width: 52rem) {
    .section-head {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Steps */
  .steps {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    counter-reset: none;
  }

  @media (min-width: 52rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-brand-soft);
  }

  .steps h3,
  .steps p {
    grid-column: 2;
    margin: 0;
  }

  .steps h3 {
    font-size: var(--text-base);
  }

  .steps p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .step-n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700;
  }

  /* Four questions */
  .bento {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .q {
    display: flex;
    flex-direction: column;
  }

  .q h3 {
    margin-bottom: var(--space-2);
  }

