---
import { withBase } from "../lib/paths";
import Base from "../layouts/Base.astro";
import ScreenGallery from "../components/ScreenGallery.astro";
import { faqs, links } from "../data/site";

const highlights = [
  "Free forever",
  "Private by design",
  "Works from your SMS",
  "Open source",
];

const does = [
  { title: "Spend today", body: "How much you can safely spend" },
  { title: "Bills", body: "What's due, in good time" },
  { title: "Leaks", body: "Where your money goes" },
  { title: "Debts", body: "Your debt-free date" },
];

const features = [
  "Your money summary in a minute",
  "Early warning before you run low",
  "A payday plan",
  "A money health score",
  "A Fuliza tracker",
  "Who owes who",
];

const steps = [
  "Pick your banks and M-Pesa",
  "The app reads those SMS on your phone",
  "Get your plan",
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">
          Know where your <span class="accent">pesa</span> goes.
        </h1>
        <p class="lead">
          Your M-Pesa and bank SMS, turned into a simple daily budget. Free,
          private, and on your phone.
        </p>
        <div class="button-row">
          <a class="button button-primary button-large" href={links.waitlist}>
            Join the waitlist
          </a>
          <a class="button button-secondary button-large" href="#how">
            How it works
          </a>
        </div>
      </div>

      <figure class="showcase">
        <div class="glow" aria-hidden="true"></div>
        <img
          class="hero-screen"
          src={withBase("/screens/home.webp")}
          width="390"
          height="844"
          alt="Pesa Clarity home screen showing safe to spend today, money left this month and upcoming bills"
          fetchpriority="high"
        />
      </figure>
    </div>

    <div class="container">
      <ul class="highlights" role="list">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="what" class="section" aria-labelledby="what-title">
    <div class="container">
      <h2 id="what-title" class="label">
        What it does
      </h2>
      <ul class="cards cards-4" role="list">
        {does.map((d) => (
          <li class="card-item">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ScreenGallery />

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title" class="label">
        Features
      </h2>
      <ul class="cards cards-3" role="list">
        {features.map((f) => (
          <li class="card-item">
            <h3>{f}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="how" class="section section-alt" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="label">
        How it works
      </h2>
      <ol class="cards cards-3 steps" role="list">
        {steps.map((s, i) => (
          <li class="card-item">
            <span class="step-n number">{i + 1}</span>
            <h3>{s}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="privacy" class="section" aria-labelledby="privacy-title">
    <div class="container split">
      <h2 id="privacy-title" class="label">
        Privacy
      </h2>
      <div>
        <p class="statement">
          Your data stays on your phone. Our server keeps only your sign-in and
          encrypted backups.
        </p>
        <a class="button button-secondary" href={withBase("/privacy/")}>
          Privacy policy
        </a>
      </div>
    </div>
  </section>

  <section
    id="open-source"
    class="section section-alt"
    aria-labelledby="foss-title"
  >
    <div class="container split">
      <h2 id="foss-title" class="label">
        Open source
      </h2>
      <div>
        <p class="statement">The code is public. Check it, or add your bank.</p>
        <div class="button-row">
          <a class="button button-secondary" href={links.github}>
            GitHub
          </a>
          <a class="button button-secondary" href={links.parserContributing}>
            Add your bank
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="container split">
      <h2 id="faq-title" class="label">
        FAQ
      </h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="join" class="section" aria-labelledby="join-title">
    <div class="container">
      <div class="cta">
        <h2 id="join-title">Be first to try it.</h2>
        <a class="button button-primary button-large" href={links.waitlist}>
          Join the waitlist
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-6);
    background:
      radial-gradient(
        48rem 32rem at 80% 0%,
        var(--color-brand-soft),
        transparent 70%
      ),
      radial-gradient(
        36rem 24rem at 0% 100%,
        var(--color-brand-soft),
        transparent 70%
      ),
      var(--color-background);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }

  .accent {
    color: var(--color-brand-link);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }

  .button-large {
    min-height: 3.25rem;
    padding-inline: var(--space-6);
  }

  .showcase {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
  }

  .hero-screen {
    position: relative;
    width: min(100%, 22rem);
    height: auto;
    border-radius: 2.75rem;
    border: 8px solid var(--color-device);
    box-shadow: 0 50px 100px -40px rgb(58 47 51 / 0.45);
  }

  .glow {
    position: absolute;
    width: min(30rem, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-brand) 22%, transparent),
      transparent 65%
    );
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .highlights li + li {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-5);
    }
  }

  /* Sections */
  .label {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  .cards {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .cards-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cards-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .card-item {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
  }

  .section-alt .card-item {
    background: var(--color-background);
  }

  .card-item h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .card-item p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .split {
    display: grid;
    gap: var(--space-4) var(--space-8);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }

    .split .label {
      margin: 0;
    }
  }

  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.35;
    margin-bottom: var(--space-5);
  }

  /* FAQ */
  .faq-list {
    display: grid;
    gap: var(--space-3);
  }

  .faq {
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: "+";
    flex: none;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-brand-link);
  }

  .faq[open] summary::after {
    content: "−";
  }

  .faq p {
    margin: 0;
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-text-muted);
  }

  /* Closing call to action */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(2rem, 1rem + 4vw, 4rem);
    border-radius: var(--radius-large);
    border: 1px solid var(--color-border);
    background:
      radial-gradient(
        40rem 20rem at 100% 0%,
        var(--color-brand-soft),
        transparent 70%
      ),
      var(--color-surface);
  }

  .cta h2 {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    margin: 0;
  }
</style>
