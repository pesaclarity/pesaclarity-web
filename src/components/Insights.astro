---
/** The analysis the app runs on the phone, and what each part does for the user. */
const now = [
  {
    title: "First insight in 60 seconds",
    body: "On setup it scans the last 90 days and shows income, spending, leaks and overdraft fees before you configure anything.",
    stat: "90 days",
    label: "of history, read in a minute",
  },
  {
    title: "Cash-flow forecast",
    body: '"At this pace you hit zero on the 18th." Warns before a card charge or bill would fail, instead of reporting it after.',
    stat: "18th",
    label: "the day you would run out",
  },
  {
    title: "Payday autopilot",
    body: "When the salary message lands, it proposes the split: rent, debts, set-asides and savings, as a checklist.",
    stat: "1 tap",
    label: "to plan each payday",
  },
  {
    title: "Financial Health Index",
    body: "A 0 to 100 score across spending, saving, borrowing and planning, with the single action that would raise it most.",
    stat: "0–100",
    label: "recalculated monthly",
  },
  {
    title: "Fuliza tracker",
    body: "Draws, fees and days overdrawn each month, with a nudge when usage starts to climb.",
    stat: "30 days",
    label: "of overdraft use at a glance",
  },
  {
    title: "Lent and borrowed",
    body: "Who owes whom among friends and family, with due dates, part payments and a polite WhatsApp reminder.",
    stat: "0%",
    label: "interest maths on family loans",
  },
];

const later = [
  "Swahili and Sheng-friendly wording",
  "Optional spending caps with a nudge at 80%",
  "Freelancer tax helper: eTIMS, withholding and iTax dates",
  "A cash-flow report you choose to share with a lender",
  "A private monthly money story",
];
---

<section id="insights" class="section" aria-labelledby="insights-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What it works out for you</p>
      <h2 id="insights-title">
        Analysis that prevents problems, not reports them
      </h2>
      <p>
        Everything below runs on your phone from your own messages and
        statements. Nothing is sent anywhere to be analysed.
      </p>
    </div>

    <div class="problem" role="note">
      <p class="problem-head">
        Why it matters: from two months of real statements
      </p>
      <dl>
        <div>
          <dt>transactions in 55 days hid what money was spent on</dt>
          <dd class="number">1,262</dd>
        </div>
        <div>
          <dt>of income went to leaks before anyone tagged them</dt>
          <dd class="number">17–27%</dd>
        </div>
        <div>
          <dt>Fuliza draws in two months, from cash running out early</dt>
          <dd class="number">~150</dd>
        </div>
      </dl>
    </div>

    <ul class="features" role="list">
      {now.map((f) => (
        <li class="feature">
          <p class="feature-stat number">{f.stat}</p>
          <p class="feature-label">{f.label}</p>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>

    <div class="later">
      <p class="later-head">After the beta, as users ask for them</p>
      <ul role="list">
        {later.map((l) => (
          <li>{l}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .problem {
    margin-bottom: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-large);
    background: var(--color-brand-soft);
  }

  .problem-head {
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .problem dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 52rem) {
    .problem dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .problem div {
    display: flex;
    flex-direction: column;
  }

  .problem dd {
    order: -1;
    margin: 0;
    font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-brand-link);
  }

  .problem dt {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .features {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 40rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .feature {
    padding: var(--space-6);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .feature p {
    margin: 0;
  }

  .feature-stat {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-brand-link);
  }

  .feature-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5) !important;
  }

  .feature h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .feature > p:last-child {
    color: var(--color-text-muted);
  }

  .later {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-large);
    border: 1px dashed var(--color-border);
  }

  .later-head {
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .later ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .later li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
</style>
