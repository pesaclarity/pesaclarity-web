---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
  class="mark"
  viewBox="0 0 512 512"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <rect width="512" height="512" rx="112" fill="var(--color-mark)"></rect>
  <rect
    x="136"
    y="132"
    width="56"
    height="268"
    rx="28"
    fill="var(--color-on-mark)"
  ></rect>
  <circle
    cx="276"
    cy="224"
    r="92"
    fill="none"
    stroke="var(--color-on-mark)"
    stroke-width="56"
  ></circle>
  <circle cx="276" cy="224" r="22" fill="var(--color-on-mark)"></circle>
</svg>
