---
import { withBase } from "../lib/paths";

/** Screens rendered from the app design canvas; regenerate the images when the designs change. */
const screens = [
  {
    file: "activity",
    name: "Activity",
    alt: "Activity screen with a search bar, account filters and transactions grouped by day",
  },
  {
    file: "plan",
    name: "Plan",
    alt: "Plan screen showing planned income split by debt, tax, living and school, and spending by category",
  },
  {
    file: "goals",
    name: "Goals",
    alt: "Goals screen with the debt-free date, debts and savings goals",
  },
  {
    file: "debts",
    name: "Debts",
    alt: "Debts screen with the payoff strategy, this payday's split, the Fuliza tracker and a what-if slider",
  },
  {
    file: "insights",
    name: "Insights",
    alt: "Insights screen with monthly leakage, where it goes and spending over six months",
  },
];
---

<section
  id="screens"
  class="section section-alt"
  aria-labelledby="screens-title"
>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Inside the app</p>
      <h2 id="screens-title">Seven screens instead of a 17-tab spreadsheet</h2>
      <p>
        Each tab answers one question. Every number taps through to the
        transactions behind it.
      </p>
    </div>

    <ul class="gallery" role="list">
      {screens.map((s) => (
        <li>
          <img
            src={withBase(`/screens/${s.file}.webp`)}
            width="390"
            height="844"
            alt={s.alt}
            loading="lazy"
            decoding="async"
          />
          <p>{s.name}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gallery > li {
    min-width: 0;
    text-align: center;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2rem;
    border: 6px solid var(--color-device);
    box-shadow: 0 30px 60px -30px rgb(58 47 51 / 0.4);
  }

  .gallery p {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
  }

  @media (max-width: 62rem) {
    .gallery {
      display: flex;
      gap: var(--space-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) var(--space-3);
      scroll-padding-inline: var(--gutter);
    }

    .gallery > li {
      flex: 0 0 min(70%, 16rem);
      scroll-snap-align: start;
    }
  }
</style>
