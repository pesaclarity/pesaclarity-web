---
/** How the iPhone version will capture messages, since iOS lets no app read SMS. */
const steps = [
  {
    title: "Sign in",
    body: "Phone number, Sign in with Apple or Google, or no account at all.",
  },
  {
    title: "Tick your accounts",
    body: "Choose the banks and wallets you use, the same as on Android.",
  },
  {
    title: "Backfill from statements",
    body: "Share M-Pesa and bank statement PDFs for your history and get the first insight.",
  },
  {
    title: "Connect with Shortcuts",
    body: "Add the Pesa Clarity shortcut in one tap, then a 30-second message automation per sender, guided step by step.",
  },
];
---

<section id="iphone" class="section section-alt" aria-labelledby="iphone-title">
  <div class="container iphone-inner">
    <div>
      <p class="eyebrow">The future on iPhone</p>
      <h2 id="iphone-title">Android first. iPhone next, the private way.</h2>
      <p class="intro">
        iOS lets no app read SMS. So the iPhone version will use Apple's own
        Shortcuts: a message automation hands each new M-Pesa or bank message to
        Pesa Clarity, and the app reads it on the phone. Statement imports fill
        any gaps. Your data still never leaves the device.
      </p>
      <p class="when">
        <span class="badge">Planned</span> After the Android beta, in the growth
        phase alongside more banks and multi-currency income.
      </p>
      <div class="status" aria-hidden="true">
        <span class="dot"></span>
        <div>
          <b>Connected</b>
          <small>Last M-Pesa message 2 min ago</small>
        </div>
      </div>
    </div>
    <ol class="ios-steps" role="list">
      {steps.map((s, i) => (
        <li>
          <span class="n number">{i + 1}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .iphone-inner {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .iphone-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  h2 {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .when {
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-block;
    margin-right: var(--space-2);
    padding: 0.1rem var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-link);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .status small {
    display: block;
    color: var(--color-text-muted);
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-success) 20%, transparent);
  }

  .ios-steps {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ios-steps li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-large);
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700;
  }

  .ios-steps h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .ios-steps p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
