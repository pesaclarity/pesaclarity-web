---
import { withBase } from "../lib/paths";
import Mark from "./Mark.astro";
import { links } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Mark size={28} />
      <p>
        Pesa Clarity is an independent, open-source project. Pre-alpha, Android
        first.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li>
          <a href={withBase("/privacy/")}>Privacy policy</a>
        </li>
        <li>
          <a href={links.github}>GitHub</a>
        </li>
        <li>
          <a href={links.webSource}>Website source</a>
        </li>
      </ul>
    </nav>
    <p class="legal muted">
      © {year} Pesa Clarity contributors. Site code under{" "}
      <a href={`${links.webSource}/blob/main/LICENSE`}>AGPL-3.0</a>; site text
      and images under{" "}
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. The
      Pesa Clarity name and logo are trademarks and are not covered by either
      licence. This site sets no cookies and runs no analytics.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-7);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-5);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-brand p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch-target);
  }

  .legal {
    margin: 0;
    max-width: var(--width-prose);
  }
</style>
